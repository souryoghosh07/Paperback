<ui:FluentWindow x:Class="Paperback.App.Views.ReaderWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  mc:Ignorable="d"
                  Title="Paperback Reader"
                  Height="850" Width="1200"
                  MinHeight="600" MinWidth="750"
                  WindowStartupLocation="CenterOwner"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  Icon="/Assets/Icons/app_icon.ico"
                  MouseMove="OnWindowMouseMove">

    <Grid x:Name="RootGrid">
        <!-- Core WebView2 Reader Viewport -->
        <wv2:WebView2 x:Name="ReaderWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <!-- Floating Top Chrome Bar (Apple Books style, auto-hiding) -->
        <Border x:Name="TopBar"
                VerticalAlignment="Top"
                Height="56"
                Margin="18,12,18,0"
                Padding="12,0"
                CornerRadius="12"
                Background="#D01E1E22"
                BorderBrush="#25FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back to Library -->
                <ui:Button Content="Library"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Transparent"
                           Foreground="#FFFFFF"
                           Click="OnBackToLibraryClicked" />

                <!-- Center: Book Title & Author -->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BookTitleHeader"
                               Text="Book Title"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450" />
                    <TextBlock x:Name="BookAuthorHeader"
                               Text="Author Name"
                               FontSize="11"
                               Foreground="#A0A0A5"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450" />
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Table of Contents -->
                    <ui:Button Icon="{ui:SymbolIcon List24}"
                               ToolTip="Table of Contents"
                               Appearance="Transparent"
                               Foreground="#FFFFFF"
                               Margin="0,0,4,0"
                               Click="OnToggleTocClicked" />

                    <!-- Typography & Theme (Aa) -->
                    <ui:Button x:Name="TypographyButton"
                               Content="Aa"
                               FontFamily="Georgia"
                               FontSize="15"
                               FontWeight="Bold"
                               ToolTip="Appearance &amp; Typography"
                               Appearance="Transparent"
                               Foreground="#FFFFFF"
                               Margin="0,0,4,0"
                               Click="OnToggleTypographyClicked" />

                    <!-- Bookmark Ribbon -->
                    <ui:Button x:Name="BookmarkButton"
                               Icon="{ui:SymbolIcon Bookmark24}"
                               ToolTip="Add Bookmark"
                               Appearance="Transparent"
                               Foreground="#FFFFFF"
                               Margin="0,0,4,0"
                               Click="OnToggleBookmarkClicked" />

                    <!-- Fullscreen Toggle -->
                    <ui:Button Icon="{ui:SymbolIcon FullScreenMaximize24}"
                               ToolTip="Toggle Fullscreen"
                               Appearance="Transparent"
                               Foreground="#FFFFFF"
                               Click="OnToggleFullscreenClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Bottom Chrome Bar (Scrubber & Page Details, auto-hiding) -->
        <Border x:Name="BottomBar"
                VerticalAlignment="Bottom"
                Height="48"
                Margin="40,0,40,16"
                Padding="16,0"
                CornerRadius="12"
                Background="#D01E1E22"
                BorderBrush="#25FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Prev Page Button -->
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}"
                           Appearance="Transparent"
                           Foreground="#FFFFFF"
                           Click="OnPrevPageClicked" />

                <!-- Chapter Title -->
                <TextBlock Grid.Column="1"
                           x:Name="ChapterTitleFooter"
                           Text="Chapter 1"
                           FontSize="12"
                           Foreground="#C0C0C8"
                           VerticalAlignment="Center"
                           Margin="12,0,16,0"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />

                <!-- Scrubber Slider -->
                <Slider Grid.Column="2"
                        x:Name="PageSlider"
                        Minimum="1"
                        Maximum="100"
                        Value="1"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="OnPageSliderValueChanged" />

                <!-- Page Progress Text (Page X of Y • 45%) -->
                <TextBlock Grid.Column="3"
                           x:Name="PageProgressText"
                           Text="Page 1 of 1 (0%)"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           Margin="16,0,12,0" />

                <!-- Next Page Button -->
                <ui:Button Grid.Column="4"
                           Icon="{ui:SymbolIcon ChevronRight24}"
                           Appearance="Transparent"
                           Foreground="#FFFFFF"
                           Click="OnNextPageClicked" />
            </Grid>
        </Border>

        <!-- Typography / Theme Popover Menu -->
        <Border x:Name="TypographyPopup"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,74,32,0"
                Width="320"
                CornerRadius="14"
                Background="#F5202024"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                Padding="18"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Theme Selectors -->
                <TextBlock Text="THEME"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8E8E93"
                           Margin="0,0,0,10" />

                <UniformGrid Columns="5" Margin="0,0,0,18">
                    <!-- White -->
                    <Border Width="42" Height="36" CornerRadius="8" Background="#FFFFFF" Cursor="Hand" Margin="2" MouseLeftButtonUp="OnThemeWhiteClicked" ToolTip="White">
                        <TextBlock Text="Aa" Foreground="#1A1A1A" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Sepia -->
                    <Border Width="42" Height="36" CornerRadius="8" Background="#F8F1E5" Cursor="Hand" Margin="2" MouseLeftButtonUp="OnThemeSepiaClicked" ToolTip="Sepia">
                        <TextBlock Text="Aa" Foreground="#382E2B" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Matte Gray -->
                    <Border Width="42" Height="36" CornerRadius="8" Background="#E8E8EC" Cursor="Hand" Margin="2" MouseLeftButtonUp="OnThemeMatteClicked" ToolTip="Matte Gray">
                        <TextBlock Text="Aa" Foreground="#242426" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Dark -->
                    <Border Width="42" Height="36" CornerRadius="8" Background="#1C1C1E" Cursor="Hand" Margin="2" MouseLeftButtonUp="OnThemeDarkClicked" ToolTip="Dark">
                        <TextBlock Text="Aa" Foreground="#F2F2F7" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- OLED Black -->
                    <Border Width="42" Height="36" CornerRadius="8" Background="#000000" BorderBrush="#33FFFFFF" BorderThickness="1" Cursor="Hand" Margin="2" MouseLeftButtonUp="OnThemeOledClicked" ToolTip="OLED Black">
                        <TextBlock Text="Aa" Foreground="#D1D1D6" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </UniformGrid>

                <Separator Background="#25FFFFFF" Margin="0,0,0,14" />

                <!-- Font Family -->
                <TextBlock Text="FONT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8E8E93"
                           Margin="0,0,0,8" />

                <ComboBox x:Name="FontFamilyCombo"
                          SelectedIndex="0"
                          Margin="0,0,0,16"
                          SelectionChanged="OnFontFamilyChanged">
                    <ComboBoxItem Content="Georgia" FontFamily="Georgia" />
                    <ComboBoxItem Content="Palatino Linotype" FontFamily="Palatino Linotype" />
                    <ComboBoxItem Content="Segoe UI" FontFamily="Segoe UI" />
                    <ComboBoxItem Content="Times New Roman" FontFamily="Times New Roman" />
                    <ComboBoxItem Content="Consolas" FontFamily="Consolas" />
                </ComboBox>

                <!-- Font Size Slider -->
                <TextBlock Text="FONT SIZE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8E8E93"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="A" FontSize="12" Foreground="#C0C0C8" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1"
                            x:Name="FontSizeSlider"
                            Minimum="13"
                            Maximum="30"
                            Value="18"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="OnFontSizeChanged" />
                    <TextBlock Grid.Column="2" Text="A" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- Text Alignment & Spread -->
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <ui:Button x:Name="JustifyButton"
                               Content="Justified"
                               Appearance="Secondary"
                               Margin="2"
                               Click="OnToggleJustifyClicked" />
                    <ui:Button x:Name="AlignLeftButton"
                               Content="Left Align"
                               Appearance="Transparent"
                               Margin="2"
                               Click="OnAlignLeftClicked" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Table of Contents Slide-out Drawer -->
        <Border x:Name="TocDrawer"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="340"
                Margin="0,70,16,16"
                CornerRadius="14"
                Background="#F5202024"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                Padding="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Table of Contents"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                               Appearance="Transparent"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Right"
                               Click="OnCloseTocClicked" />
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="TocListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnTocItemSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#FFFFFF"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PageNumber, StringFormat='p. {0}'}"
                                           Foreground="#8E8E93"
                                           FontSize="11"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
